WITH

THANKVIEW_DATA AS (
SELECT

  -- RECIPIENT DATA
  E.SENT_TO AS TV_DELIVERY_EMAIL,
  
  --DELIVERY STATS
  DATE(E.SENT_DATE) AS SENT_DATE,
  DATE(E.UPDATED_AT) AS UPDATED_AT,
  E.BOUNCED AS BOUNCED,
  E.UNSUBSCRIBED,
  E.DEVICE,
  E.BROWSER,
  E.PLATFORM,
  E.LOCATION_ID,

  -- EMAIL STATS
  E.READ_EMAIL,
  DATE(E.READ_EMAIL_DATE) AS READ_EMAIL_DATE,
  E.OPENED,
  DATE(E.OPENED_DATE) AS OPENED_DATE,  -- EVALUATE TIME FROM SEND TO OPEN AS ENGAGEMENT POINT
  E.CLICKS,
  E.CTA_CLICKED,
  DATE(CTA_CLICKED_DATE) AS CTA_CLICKED_DATE,

  -- VIDEO STATS
  E.VIEWS AS VIDEO_VIEWS,
  E.STARTED_VIDEO,
  DATE(E.STARTED_VIDEO_DATE) AS STARTED_VIDEO_DATE,
  E.FINISHED_VIDEO,
  E.VIDEO_POS_1,
  E.VIDEO_POS_2,
  E.VIDEO_POS_3,
  E.SHARES AS VIDEO_SHARES_TO_FACEBOOK,
  E.DOWNLOADS AS VIDEO_DOWNLOADS

FROM
  BW.THANKVIEWS.EXT_EMAILS E
ORDER BY
  E.SENT_TO, 
  E.SENT_DATE
),


EVERTRUE_CUSTOMER_DATA AS (
SELECT
  E.EMAIL AS ET_EMAIL,
  COUNT(DISTINCT E.CONTACT_ID) AS ET_CONTACT_ID_COUNT,
  LISTAGG(DISTINCT E.CONTACT_ID, ',') AS ET_CONTACT_IDS,
  LISTAGG(DISTINCT I.OID, ',') AS ET_OIDS,
  LISTAGG(DISTINCT O.NAME, ',') AS ET_CUSTOMER_NAMES
FROM
  BW.CONTACTS.ICE_EMAIL E
  LEFT JOIN BW.CONTACTS.ICE_IDENTITY I ON E.CONTACT_ID = I.CONTACT_ID
  LEFT JOIN BW.AUTH.EXT_ORGANIZATIONS O ON I.OID = O.OID
WHERE
  E.EMAIL IN (SELECT DISTINCT TV_DELIVERY_EMAIL FROM THANKVIEW_DATA)
  AND O.TEST_ORG = 0
  AND O.DELETED = 0
GROUP BY
  E.EMAIL
)


-- FINAL PULL

SELECT
  -- EMAIL OWNER METADATA
  TV_DELIVERY_EMAIL,
  ET_CONTACT_ID_COUNT,
  ET_CONTACT_IDS,
  ET_OIDS,
  ET_CUSTOMER_NAMES,
  
  --DELIVERY STATS
  SENT_DATE,
  UPDATED_AT,
  BOUNCED,
  UNSUBSCRIBED,
  DEVICE,
  BROWSER,
  PLATFORM,
  LOCATION_ID,

  -- EMAIL STATS
  READ_EMAIL,
  READ_EMAIL_DATE,
  OPENED,
  OPENED_DATE,  
  CLICKS,
  CTA_CLICKED,
  CTA_CLICKED_DATE,

  -- VIDEO STATS
  VIDEO_VIEWS,
  STARTED_VIDEO,
  STARTED_VIDEO_DATE,
  FINISHED_VIDEO,
  VIDEO_POS_1,
  VIDEO_POS_2,
  VIDEO_POS_3,
  VIDEO_SHARES_TO_FACEBOOK,
  VIDEO_DOWNLOADS
FROM 
  THANKVIEW_DATA T
  LEFT JOIN EVERTRUE_CUSTOMER_DATA E ON T.TV_DELIVERY_EMAIL = E.ET_EMAIL;
